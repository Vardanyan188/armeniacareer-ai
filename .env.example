# ArmeniaCareer AI — environment template.
# Copy to `.env` and fill in real values. NEVER commit a populated .env.

# OpenAI — Shared Analysis Engine (gpt-4.1-mini) + embeddings (text-embedding-3-small)
OPENAI_API_KEY=

# Google Gemini — Candidate/Recruiter narrative generation (gemini-2.0-flash)
GOOGLE_API_KEY=

# Application environment: local | dev | demo | prod
APP_ENV=local

# ── Feature gates (Phase 22) ────────────────────────────────────────────────
# Admin/Demo workspace is hidden unless enabled (and never in demo/prod/public).
ACAI_ENABLE_ADMIN=
# Private Data Ingest panel (internal only; never enable in a public deploy).
ACAI_ENABLE_INGEST=
# Candidate Pool persistence (allowed in local/dev by default; off in public).
ACAI_ENABLE_CANDIDATE_POOL=
# Privacy-safe JSONL audit logs (workflow + security). Off by default.
ACAI_ENABLE_AUDIT_LOG=
# Show sanitized technical details (local/dev only; never public).
ACAI_DEBUG=
# Hard public lockdown: forces Admin/Ingest/Pool/Debug OFF regardless of flags.
ACAI_PUBLIC_DEMO=
